comment3.text=\r\n\ Mueve\ el\ objeto\ a\ una\ posici\u00F3n\ indicada.\r\n\ \r\n\ @param\ x\ La\ posici\u00F3n\ en\ x\ deseada.\r\n\ @param\ y\ La\ posici\u00F3n\ en\ y\ deseada.\r\n
